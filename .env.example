# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development           # development | production

# ─── Groq API (FREE tier — no credit card needed) ────────────────────────────
# Sign up free at: https://console.groq.com
# Used for: LLM-assisted damage classification fallback, photo-tier scene understanding
# Models available free: llama3-70b-8192, llama3-8b-8192, mixtral-8x7b-32768
GROQ_API_KEY=                 # paste your key here → gsk_...

# Groq model to use (free tier supports all below):
GROQ_MODEL=llama3-70b-8192    # Options: llama3-70b-8192 | llama3-8b-8192 | mixtral-8x7b-32768

# ─── HuggingFace (optional — for gated models like SAM2) ─────────────────────
# HUGGINGFACE_TOKEN=           # paste your HF token here → hf_...

# ─── Model Weight Sources ─────────────────────────────────────────────────────
# Set these if you host model weights on a private bucket/URL
# MODEL_WEIGHTS_BASE_URL=https://your-bucket.s3.amazonaws.com/models

# ─── Pipeline Tuning ──────────────────────────────────────────────────────────
# These override config/default.yaml values (useful for CI/experiments)
# PLANE_DETECTION__DISTANCE_THRESHOLD=0.02
# FLOOR_PLAN__MIN_WALL_LENGTH=0.3
# DATA__DEPTH_SCALE_FACTOR=0.001

# ─── Output ───────────────────────────────────────────────────────────────────
# OUTPUT_DIR=./outputs         # Where to save generated floor plans & JSONs
# LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
